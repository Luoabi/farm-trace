.container {
  width: 100%;
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f5f5f5;
}

/* 顶部选中显示 */
.selected-bar {
  background: white;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #eee;
}

.selected-item {
  display: flex;
  align-items: center;
}

.label {
  font-size: 28rpx;
  color: #999;
  margin-right: 12rpx;
}

.value {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  flex: 1;
}

/* 标签页 */
.tabs {
  background: white;
  display: flex;
  border-bottom: 1rpx solid #eee;
}

.tab-item {
  flex: 1;
  padding: 24rpx 0;
  text-align: center;
  position: relative;
}

.tab-item.disabled {
  opacity: 0.4;
}

.tab-text {
  font-size: 28rpx;
  color: #666;
}

.tab-item.active .tab-text {
  color: #667eea;
  font-weight: bold;
}

.tab-line {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 4rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 2rpx;
}

/* 列表容器 */
.list-container {
  flex: 1;
  background: white;
  margin-top: 20rpx;
}

.list {
  width: 100%;
}

.list-item {
  padding: 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
  display: flex;
  justify-content: space-between;
  align-items: center;
  transition: background 0.3s;
}

.list-item:active {
  background: #f8f8f8;
}

.list-item.selected {
  background: #f0f4ff;
}

.item-text {
  font-size: 30rpx;
  color: #333;
  flex: 1;
}

.list-item.selected .item-text {
  color: #667eea;
  font-weight: 500;
}

.check-icon {
  font-size: 36rpx;
  color: #667eea;
  font-weight: bold;
  margin-left: 20rpx;
}

/* 底部按钮 */
.footer {
  background: white;
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  gap: 20rpx;
  box-shadow: 0 -4rpx 12rpx rgba(0, 0, 0, 0.05);
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}

.btn-cancel,
.btn-confirm {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: bold;
}

.btn-cancel {
  background: #f5f5f5;
  color: #666;
}

.btn-confirm {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
}

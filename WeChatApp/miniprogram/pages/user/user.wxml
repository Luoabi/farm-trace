<view class="container">
  <!-- 用户信息 -->
  <view class="user-header">
    <view class="avatar">
      <text class="avatar-icon">👤</text>
    </view>
    <view class="user-info">
      <text class="username">{{userInfo.realName || '未登录'}}</text>
      <text class="phone">{{userInfo.phone || ''}}</text>
    </view>
  </view>

  <!-- 订单统计 -->
  <view class="order-stats">
    <view class="stat-item" bindtap="goToOrders" data-status="WAITING_PAYMENT">
      <text class="stat-icon">💰</text>
      <text class="stat-label">待支付</text>
    </view>
    <view class="stat-item" bindtap="goToOrders" data-status="PAID">
      <text class="stat-icon">📦</text>
      <text class="stat-label">待发货</text>
    </view>
    <view class="stat-item" bindtap="goToOrders" data-status="SHIPPED">
      <text class="stat-icon">🚚</text>
      <text class="stat-label">待收货</text>
    </view>
    <view class="stat-item" bindtap="goToOrders" data-status="DELIVERED">
      <text class="stat-icon">✅</text>
      <text class="stat-label">已完成</text>
    </view>
  </view>

  <!-- 功能菜单 -->
  <view class="menu-section">
    <view class="menu-item" bindtap="goToAddressList">
      <view class="menu-left">
        <text class="menu-icon">📍</text>
        <text class="menu-label">收货地址</text>
      </view>
      <text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="handleScan">
      <view class="menu-left">
        <text class="menu-icon">🔍</text>
        <text class="menu-label">溯源查询</text>
      </view>
      <text class="arrow">›</text>
    </view>
  </view>

  <!-- 退出登录 -->
  <view class="logout-section">
    <button class="btn-logout" bindtap="handleLogout">退出登录</button>
  </view>
</view>

/* Skyline 渲染引擎样式修复 */
page {
  height: 100%;
  width: 100%;
}

.container {
  min-height: 100vh;
  width: 100%;
  background: #f5f5f5;
}

.user-header {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 60rpx 40rpx;
  display: flex;
  align-items: center;
  gap: 30rpx;
  width: 100%;
  box-sizing: border-box;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  background: white;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.avatar-icon {
  font-size: 60rpx;
  line-height: 1;
}

.user-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  min-width: 0;
}

.username {
  font-size: 36rpx;
  font-weight: bold;
  color: white;
  line-height: 1.2;
}

.phone {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  line-height: 1.5;
}

.order-stats {
  display: flex;
  background: white;
  padding: 40rpx 20rpx;
  margin: 20rpx;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  width: calc(100% - 40rpx);
  box-sizing: border-box;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.stat-icon {
  font-size: 48rpx;
  line-height: 1;
}

.stat-label {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
}

.menu-section {
  background: white;
  margin: 20rpx;
  border-radius: 16rpx;
  overflow: hidden;
  width: calc(100% - 40rpx);
  box-sizing: border-box;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 40rpx;
  border-bottom: 1rpx solid #f5f5f5;
  width: 100%;
  box-sizing: border-box;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-left {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.menu-icon {
  font-size: 40rpx;
  line-height: 1;
  flex-shrink: 0;
}

.menu-label {
  font-size: 30rpx;
  color: #333;
  line-height: 1.5;
}

.arrow {
  font-size: 48rpx;
  color: #ccc;
  line-height: 1;
  flex-shrink: 0;
}

.logout-section {
  padding: 40rpx;
  width: 100%;
  box-sizing: border-box;
}

.btn-logout {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: white;
  color: #ff6b6b;
  font-size: 32rpx;
  border-radius: 12rpx;
  border: 2rpx solid #ff6b6b;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-logout::after {
  border: none;
}

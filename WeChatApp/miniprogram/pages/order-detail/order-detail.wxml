<view class="container" wx:if="{{order}}">
  <!-- 订单状态 -->
  <view class="status-section">
    <view class="status-icon">
      <text wx:if="{{order.status === 'WAITING_PAYMENT'}}">💰</text>
      <text wx:elif="{{order.status === 'PAID'}}">📦</text>
      <text wx:elif="{{order.status === 'SHIPPED'}}">🚚</text>
      <text wx:elif="{{order.status === 'DELIVERED'}}">✅</text>
      <text wx:else>❌</text>
    </view>
    <view class="status-text">{{statusMap[order.status]}}</view>
  </view>

  <!-- 收货地址 -->
  <view class="address-section">
    <view class="section-title">
      <text class="icon">📍</text>
      <text>收货信息</text>
    </view>
    <view class="address-content">
      <view class="address-header">
        <text class="receiver">{{order.customerName}}</text>
        <text class="phone">{{order.customerPhone}}</text>
      </view>
      <view class="address-detail">{{order.shippingAddress}}</view>
    </view>
  </view>

  <!-- 商品列表 -->
  <view class="goods-section">
    <view class="section-title">
      <text class="icon">📦</text>
      <text>商品清单</text>
    </view>
    <view class="goods-list">
      <view class="goods-item" wx:for="{{order.items}}" wx:key="productId">
        <view class="goods-info">
          <text class="goods-name">{{item.productName}}</text>
          <view class="goods-footer">
            <text class="goods-price">¥{{item.price}}/{{item.unit}}</text>
            <text class="goods-quantity">x{{item.quantity}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 订单信息 -->
  <view class="info-section">
    <view class="section-title">
      <text class="icon">📋</text>
      <text>订单信息</text>
    </view>
    <view class="info-list">
      <view class="info-item">
        <text class="label">订单编号</text>
        <view class="value-box">
          <text class="value">{{order.orderNumber}}</text>
          <text class="copy-btn" bindtap="copyOrderNumber">复制</text>
        </view>
      </view>
      <view class="info-item">
        <text class="label">下单时间</text>
        <text class="value">{{order.createdAt}}</text>
      </view>
      <view class="info-item">
        <text class="label">配送方式</text>
        <text class="value">{{order.shippingMethod}}</text>
      </view>
      <view class="info-item" wx:if="{{order.remark}}">
        <text class="label">订单备注</text>
        <text class="value">{{order.remark}}</text>
      </view>
    </view>
  </view>

  <!-- 价格明细 -->
  <view class="price-section">
    <view class="price-item">
      <text class="label">商品总价</text>
      <text class="value">¥{{order.totalAmount.toFixed(2)}}</text>
    </view>
    <view class="price-item">
      <text class="label">配送费</text>
      <text class="value">¥0.00</text>
    </view>
    <view class="price-item total">
      <text class="label">实付款</text>
      <text class="amount">¥{{order.totalAmount.toFixed(2)}}</text>
    </view>
  </view>

  <!-- 底部操作栏 -->
  <view class="footer" wx:if="{{order.status !== 'CANCELLED' && order.status !== 'DELIVERED'}}">
    <view class="btn-cancel" wx:if="{{order.status === 'WAITING_PAYMENT' || order.status === 'PAID'}}" bindtap="handleCancelOrder">
      <text>取消订单</text>
    </view>
    <view class="btn-confirm" wx:if="{{order.status === 'SHIPPED'}}" bindtap="handleConfirmReceipt">
      <text>确认收货</text>
    </view>
  </view>
</view>

<view class="loading" wx:if="{{loading}}">
  <text>加载中...</text>
</view>

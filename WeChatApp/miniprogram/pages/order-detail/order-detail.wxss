.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 120rpx;
}

.status-section {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 60rpx 30rpx;
  text-align: center;
  color: white;
  width: 100%;
  box-sizing: border-box;
}

.status-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
  line-height: 1;
}

.status-text {
  font-size: 36rpx;
  font-weight: bold;
  line-height: 1.4;
}

.address-section,
.goods-section,
.info-section,
.price-section {
  background: white;
  padding: 30rpx;
  margin-bottom: 20rpx;
  width: 100%;
  box-sizing: border-box;
}

.section-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #eee;
  line-height: 1.4;
}

.section-title .icon {
  font-size: 36rpx;
  line-height: 1;
  flex-shrink: 0;
}

.address-content {
  padding: 20rpx;
  background: #f5f7fa;
  border-radius: 12rpx;
  width: 100%;
  box-sizing: border-box;
}

.address-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 12rpx;
  flex-wrap: wrap;
}

.receiver {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  line-height: 1.4;
}

.phone {
  font-size: 28rpx;
  color: #666;
  line-height: 1.5;
}

.address-detail {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
}

.goods-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  width: 100%;
}

.goods-item {
  padding: 20rpx;
  background: #f5f7fa;
  border-radius: 12rpx;
  width: 100%;
  box-sizing: border-box;
}

.goods-info {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  width: 100%;
}

.goods-name {
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
}

.goods-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
}

.goods-price {
  font-size: 28rpx;
  color: #ff6b6b;
  font-weight: bold;
  line-height: 1.5;
}

.goods-quantity {
  font-size: 26rpx;
  color: #999;
  line-height: 1.5;
}

.info-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  width: 100%;
}

.info-item {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  font-size: 28rpx;
  width: 100%;
}

.label {
  color: #999;
  width: 150rpx;
  flex-shrink: 0;
  line-height: 1.5;
}

.value-box {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 20rpx;
  min-width: 0;
}

.value {
  color: #333;
  text-align: right;
  word-break: break-all;
  line-height: 1.5;
}

.copy-btn {
  padding: 4rpx 16rpx;
  background: #667eea;
  color: white;
  font-size: 24rpx;
  border-radius: 4rpx;
  line-height: 1.5;
  flex-shrink: 0;
}

.price-section {
  background: white;
  padding: 30rpx;
  width: 100%;
  box-sizing: border-box;
}

.price-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  font-size: 28rpx;
  line-height: 1.5;
  width: 100%;
}

.price-item:last-child {
  margin-bottom: 0;
}

.price-item.total {
  padding-top: 20rpx;
  border-top: 1rpx solid #eee;
  margin-top: 10rpx;
}

.amount {
  font-size: 36rpx;
  font-weight: bold;
  color: #ff6b6b;
  line-height: 1.2;
}

.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  width: 100%;
  height: 120rpx;
  background: white;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding: 0 30rpx;
  gap: 20rpx;
  box-shadow: 0 -4rpx 12rpx rgba(0, 0, 0, 0.05);
  box-sizing: border-box;
}

.btn-cancel,
.btn-confirm {
  padding: 0 40rpx;
  height: 70rpx;
  border-radius: 35rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  line-height: 1;
  flex-shrink: 0;
}

.btn-cancel {
  background: white;
  border: 2rpx solid #999;
  color: #999;
}

.btn-confirm {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  font-weight: bold;
}

.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  font-size: 28rpx;
  color: #999;
  line-height: 1.5;
}

/* Skyline 渲染引擎样式修复 */
page {
  height: 100%;
  width: 100%;
}

.container {
  min-height: 100vh;
  width: 100%;
  display: flex;
  flex-direction: column;
  background: #f5f5f5;
  padding-top: 0;
}

.tabs {
  display: flex;
  background: white;
  padding: 20rpx;
  gap: 20rpx;
  overflow-x: auto;
  white-space: nowrap;
  width: 100%;
  box-sizing: border-box;
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.tab-item {
  flex-shrink: 0;
  padding: 12rpx 32rpx;
  background: #f5f7fa;
  border-radius: 40rpx;
  font-size: 28rpx;
  color: #666;
  line-height: 1.5;
}

.tab-item.active {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
}

.order-list {
  flex: 1;
  padding: 20rpx;
  width: 100%;
  box-sizing: border-box;
}

.order-item {
  background: white;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  width: 100%;
  box-sizing: border-box;
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #eee;
  margin-bottom: 20rpx;
  width: 100%;
}

.order-number {
  font-size: 26rpx;
  color: #999;
  line-height: 1.5;
}

.order-status {
  font-size: 28rpx;
  font-weight: bold;
  line-height: 1.5;
}

.status-0 {
  color: #ff9800;
}

.status-1 {
  color: #2196f3;
}

.status-2 {
  color: #667eea;
}

.status-3 {
  color: #4caf50;
}

.status-4 {
  color: #999;
}

.order-content {
  margin-bottom: 20rpx;
}

.product-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.product-name {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
  flex: 1;
}

.product-detail {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.product-price {
  font-size: 32rpx;
  color: #ff6b6b;
  font-weight: bold;
}

.product-quantity {
  font-size: 26rpx;
  color: #999;
}

.order-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.info-item {
  font-size: 24rpx;
  color: #999;
}

.order-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 20rpx;
  border-top: 1rpx solid #eee;
  width: 100%;
}

.total-box {
  display: flex;
  align-items: baseline;
}

.total-label {
  font-size: 26rpx;
  color: #666;
}

.total-amount {
  font-size: 32rpx;
  font-weight: bold;
  color: #ff6b6b;
  line-height: 1.2;
}

.action-buttons {
  display: flex;
  gap: 16rpx;
}

.btn {
  padding: 12rpx 28rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  line-height: 1;
  white-space: nowrap;
}

.btn-cancel {
  background: #fff;
  color: #999;
  border: 1rpx solid #ddd;
}

.btn-primary {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
}

.btn-delete {
  background: #fff;
  color: #f44336;
  border: 1rpx solid #f44336;
}

.btn-detail {
  background: #fff;
  color: #667eea;
  border: 1rpx solid #667eea;
}

.loading-more,
.no-more {
  text-align: center;
  padding: 40rpx 0;
  font-size: 28rpx;
  color: #999;
  line-height: 1.5;
}

.empty {
  text-align: center;
  padding: 200rpx 0;
  width: 100%;
}

.empty-icon {
  display: block;
  font-size: 120rpx;
  margin-bottom: 20rpx;
  line-height: 1;
}

.empty-text {
  display: block;
  font-size: 28rpx;
  color: #999;
  line-height: 1.5;
}

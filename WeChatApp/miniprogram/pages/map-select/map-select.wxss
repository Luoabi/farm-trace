.container {
  width: 100%;
  height: 100vh;
  position: relative;
  background: #f5f5f5;
}

.map {
  width: 100%;
  height: 100%;
}

/* 中心标记点 */
.center-marker {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -100%);
  z-index: 10;
}

.marker-pin {
  font-size: 80rpx;
  line-height: 1;
  filter: drop-shadow(0 4rpx 8rpx rgba(0, 0, 0, 0.3));
}

/* 重新定位按钮 */
.relocate-btn {
  position: absolute;
  right: 30rpx;
  bottom: 400rpx;
  width: 80rpx;
  height: 80rpx;
  background: white;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
  z-index: 20;
}

.relocate-icon {
  font-size: 48rpx;
  line-height: 1;
}

/* 地址信息卡片 */
.address-card {
  position: absolute;
  bottom: 180rpx;
  left: 30rpx;
  right: 30rpx;
  background: white;
  border-radius: 24rpx;
  padding: 30rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
  z-index: 30;
}

.card-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.card-header .icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.card-header .title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.address-info {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.name {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  line-height: 1.5;
}

.address {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

.placeholder {
  font-size: 28rpx;
  color: #999;
  text-align: center;
  padding: 20rpx 0;
}

/* 微信位置选择按钮 */
.wx-choose-btn {
  margin-top: 24rpx;
  padding: 20rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.btn-icon {
  font-size: 32rpx;
}

.btn-text {
  font-size: 28rpx;
  color: white;
  font-weight: 500;
}

/* 底部按钮 */
.footer {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 140rpx;
  background: white;
  display: flex;
  align-items: center;
  padding: 0 30rpx;
  gap: 20rpx;
  box-shadow: 0 -4rpx 12rpx rgba(0, 0, 0, 0.05);
  z-index: 40;
}

.btn-cancel,
.btn-confirm {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: bold;
}

.btn-cancel {
  background: #f5f5f5;
  color: #666;
}

.btn-confirm {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
}

<view class="container" wx:if="{{product}}">
  <!-- 商品图片 -->
  <view class="product-image-wrapper">
    <image class="product-image" src="{{product.imageUrl || '/images/default-product.png'}}" mode="aspectFill"></image>
  </view>

  <!-- 商品信息 -->
  <view class="product-info">
    <view class="product-name">{{product.name}}</view>
    <view class="product-desc">{{product.description || '新鲜优质'}}</view>
    <view class="price-box">
      <text class="price">¥{{product.price}}</text>
      <text class="unit">/{{product.unit}}</text>
      <text class="stock">库存：{{product.stock}}{{product.unit}}</text>
    </view>
  </view>

  <!-- 数量选择 -->
  <view class="quantity-section">
    <text class="label">购买数量</text>
    <view class="quantity-control">
      <view class="btn-minus" bindtap="handleQuantityChange" data-type="minus">-</view>
      <text class="quantity">{{quantity}}</text>
      <view class="btn-plus" bindtap="handleQuantityChange" data-type="plus">+</view>
    </view>
  </view>

  <!-- 商品详情 -->
  <view class="detail-section">
    <view class="section-title">商品详情</view>
    <view class="detail-content">
      <view class="detail-item">
        <text class="detail-label">分类：</text>
        <text class="detail-value">{{product.category}}</text>
      </view>
      <view class="detail-item">
        <text class="detail-label">状态：</text>
        <text class="detail-value">{{product.status === '上架' ? '在售' : '已下架'}}</text>
      </view>
      <view class="detail-item" wx:if="{{product.farmerName}}">
        <text class="detail-label">供应商：</text>
        <text class="detail-value">{{product.farmerName}}</text>
      </view>
    </view>
  </view>

  <!-- 底部操作栏 -->
  <view class="footer">
    <view class="btn-cart" bindtap="addToCart">
      <text>加入购物车</text>
    </view>
    <view class="btn-buy" bindtap="buyNow">
      <text>立即购买</text>
    </view>
  </view>
</view>

<view class="loading" wx:if="{{loading}}">
  <text>加载中...</text>
</view>

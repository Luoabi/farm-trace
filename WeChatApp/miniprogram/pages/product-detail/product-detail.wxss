.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 120rpx;
}

.product-image-wrapper {
  width: 100%;
  height: 600rpx;
  background: white;
}

.product-image {
  width: 100%;
  height: 100%;
  display: block;
}

.product-info {
  background: white;
  padding: 30rpx;
  margin-bottom: 20rpx;
  width: 100%;
  box-sizing: border-box;
}

.product-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
  line-height: 1.4;
}

.product-desc {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 20rpx;
  line-height: 1.5;
}

.price-box {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  width: 100%;
}

.price {
  font-size: 48rpx;
  font-weight: bold;
  color: #ff6b6b;
  line-height: 1.2;
}

.unit {
  font-size: 28rpx;
  color: #999;
  line-height: 1.5;
}

.stock {
  margin-left: auto;
  font-size: 28rpx;
  color: #666;
  line-height: 1.5;
}

.quantity-section {
  background: white;
  padding: 30rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  box-sizing: border-box;
}

.label {
  font-size: 30rpx;
  color: #333;
  line-height: 1.5;
}

.quantity-control {
  display: flex;
  align-items: center;
  gap: 30rpx;
}

.btn-minus,
.btn-plus {
  width: 60rpx;
  height: 60rpx;
  background: #f5f7fa;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #666;
  line-height: 1;
  flex-shrink: 0;
}

.quantity {
  min-width: 80rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: bold;
  line-height: 1.5;
}

.detail-section {
  background: white;
  padding: 30rpx;
  width: 100%;
  box-sizing: border-box;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #eee;
  line-height: 1.4;
}

.detail-content {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  width: 100%;
}

.detail-item {
  display: flex;
  font-size: 28rpx;
  line-height: 1.5;
  width: 100%;
}

.detail-label {
  color: #999;
  width: 150rpx;
  flex-shrink: 0;
}

.detail-value {
  flex: 1;
  color: #333;
  word-break: break-all;
}

.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  width: 100%;
  height: 120rpx;
  background: white;
  display: flex;
  padding: 20rpx;
  gap: 20rpx;
  box-shadow: 0 -4rpx 12rpx rgba(0, 0, 0, 0.05);
  box-sizing: border-box;
}

.btn-cart,
.btn-buy {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: bold;
  line-height: 1;
}

.btn-cart {
  background: #fff;
  border: 2rpx solid #667eea;
  color: #667eea;
}

.btn-buy {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
}

.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  font-size: 28rpx;
  color: #999;
  line-height: 1.5;
}

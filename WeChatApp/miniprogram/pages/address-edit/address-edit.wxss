.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 120rpx;
}

.form {
  background: white;
  width: 100%;
}

.form-item {
  padding: 30rpx;
  border-bottom: 1rpx solid #eee;
  width: 100%;
  box-sizing: border-box;
}

.form-item:last-child {
  border-bottom: none;
}

.label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 16rpx;
  line-height: 1.5;
}

.input,
.textarea {
  width: 100%;
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
}

.input {
  height: 60rpx;
  line-height: 60rpx;
}

.textarea {
  min-height: 150rpx;
  padding: 20rpx;
  background: #f5f7fa;
  border-radius: 12rpx;
  box-sizing: border-box;
}

.region-box {
  padding: 20rpx;
  background: #f5f7fa;
  border-radius: 12rpx;
  width: 100%;
  box-sizing: border-box;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border: 2rpx solid #e0e0e0;
  transition: all 0.3s;
}

.region-box:active {
  background: #eef1f6;
  border-color: #667eea;
}

.region-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
  flex: 1;
}

.icon {
  font-size: 40rpx;
  color: #999;
  margin-left: 10rpx;
}

.hint-text {
  font-size: 24rpx;
  color: #999;
  margin-top: 12rpx;
  line-height: 1.5;
}

.address-input-box {
  position: relative;
}

.map-btn {
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
  display: flex;
  align-items: center;
  padding: 10rpx 20rpx;
  background: #667eea;
  color: white;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.map-icon {
  margin-right: 8rpx;
  font-size: 28rpx;
}

.map-text {
  font-size: 24rpx;
}

.switch-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
}

.switch-item .label {
  margin-bottom: 0;
}

.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  width: 100%;
  height: 120rpx;
  background: white;
  display: flex;
  align-items: center;
  padding: 0 30rpx;
  box-shadow: 0 -4rpx 12rpx rgba(0, 0, 0, 0.05);
  box-sizing: border-box;
}

.btn-submit {
  width: 100%;
  height: 80rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.btn-submit.disabled {
  opacity: 0.6;
}

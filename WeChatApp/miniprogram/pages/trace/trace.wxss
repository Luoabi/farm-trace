/* 溯源查询页面样式 */

.trace-container {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  position: relative;
}

/* 验证加载遮罩 */
.verify-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.7);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
  animation: fadeIn 0.3s ease;
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

.verify-modal {
  width: 600rpx;
  background: #fff;
  border-radius: 30rpx;
  padding: 60rpx 40rpx;
  animation: slideUp 0.4s ease;
}

@keyframes slideUp {
  from {
    transform: translateY(100rpx);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

/* 验证动画 */
.verify-animation {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto 50rpx;
}

.spinner {
  position: absolute;
  width: 100%;
  height: 100%;
  border: 6rpx solid #f3f3f3;
  border-top: 6rpx solid #667eea;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.pulse-ring {
  position: absolute;
  width: 100%;
  height: 100%;
  border: 6rpx solid #667eea;
  border-radius: 50%;
  opacity: 0;
  animation: pulse 2s ease-out infinite;
}

@keyframes pulse {
  0% {
    transform: scale(0.8);
    opacity: 1;
  }
  100% {
    transform: scale(1.5);
    opacity: 0;
  }
}

/* 验证步骤 */
.verify-steps {
  margin-bottom: 40rpx;
}

.verify-step {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  opacity: 0.3;
  transition: all 0.3s ease;
  position: relative;
}

.verify-step.active {
  opacity: 1;
  animation: stepIn 0.4s ease;
}

@keyframes stepIn {
  from {
    transform: translateX(-20rpx);
    opacity: 0;
  }
  to {
    transform: translateX(0);
    opacity: 1;
  }
}

.step-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.step-text {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.step-check {
  font-size: 32rpx;
  color: #4caf50;
  font-weight: bold;
  animation: checkIn 0.3s ease;
}

@keyframes checkIn {
  0% {
    transform: scale(0);
  }
  50% {
    transform: scale(1.2);
  }
  100% {
    transform: scale(1);
  }
}

/* 验证提示 */
.verify-tip {
  text-align: center;
  padding: 30rpx;
  background: #f8f9fa;
  border-radius: 15rpx;
  font-size: 24rpx;
  color: #666;
  line-height: 1.6;
}

/* 查询区域 */
.query-section {
  padding: 60rpx 40rpx;
}

.query-header {
  text-align: center;
  margin-bottom: 80rpx;
}

.logo {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 30rpx;
}

.title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 20rpx;
}

.subtitle {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
}

.query-content {
  background: #fff;
  border-radius: 30rpx;
  padding: 60rpx 40rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.1);
}

/* 扫码按钮 */
.scan-button {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 300rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 20rpx;
  margin-bottom: 40rpx;
}

.scan-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.scan-text {
  font-size: 32rpx;
  color: #fff;
  font-weight: 500;
}

/* 分隔线 */
.divider {
  display: flex;
  align-items: center;
  margin: 40rpx 0;
}

.divider-line {
  flex: 1;
  height: 1rpx;
  background: #e0e0e0;
}

.divider-text {
  margin: 0 20rpx;
  color: #999;
  font-size: 28rpx;
}

/* 输入区域 */
.input-section {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.batch-input {
  height: 90rpx;
  padding: 0 30rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 15rpx;
  font-size: 30rpx;
}

.query-button {
  height: 90rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border: none;
  border-radius: 15rpx;
  font-size: 32rpx;
  font-weight: 500;
}

/* 结果区域 */
.result-section {
  min-height: 100vh;
  background: #f5f5f5;
}

.result-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 40rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
}

.header-content {
  flex: 1;
}

.product-name {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.batch-number {
  display: block;
  font-size: 26rpx;
  opacity: 0.9;
}

.reset-button {
  padding: 15rpx 30rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 30rpx;
  font-size: 26rpx;
}

/* 验证横幅 */
.verification-banner {
  display: flex;
  align-items: center;
  padding: 30rpx 40rpx;
  margin: 20rpx;
  border-radius: 15rpx;
}

.verification-banner.verified {
  background: #e8f5e9;
  color: #2e7d32;
}

.verification-banner.unverified {
  background: #fff3e0;
  color: #e65100;
}

.verification-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.verification-text {
  font-size: 28rpx;
  font-weight: 500;
}

/* 标签页 */
.tabs {
  display: flex;
  background: #fff;
  margin: 20rpx;
  border-radius: 15rpx;
  overflow: hidden;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 30rpx 0;
  font-size: 28rpx;
  color: #666;
  transition: all 0.3s;
}

.tab-item.active {
  color: #667eea;
  font-weight: bold;
  background: #f0f4ff;
}

/* 标签内容 */
.tab-content {
  padding: 0 20rpx 40rpx;
}

/* 信息卡片 */
.info-card {
  background: #fff;
  border-radius: 15rpx;
  padding: 40rpx;
}

.info-item {
  display: flex;
  justify-content: space-between;
  padding: 25rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-item:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 28rpx;
  color: #666;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.info-value {
  font-size: 28rpx;
  color: #333;
  text-align: right;
  flex: 1;
}

/* 时间轴 */
.timeline {
  position: relative;
  padding-left: 60rpx;
}

.timeline-item {
  position: relative;
  padding-bottom: 50rpx;
}

.timeline-item:last-child {
  padding-bottom: 0;
}

.timeline-dot {
  position: absolute;
  left: -60rpx;
  top: 10rpx;
  width: 20rpx;
  height: 20rpx;
  background: #667eea;
  border-radius: 50%;
  border: 4rpx solid #fff;
  box-shadow: 0 0 0 4rpx #667eea;
}

.timeline-item::before {
  content: '';
  position: absolute;
  left: -51rpx;
  top: 30rpx;
  bottom: -50rpx;
  width: 2rpx;
  background: #e0e0e0;
}

.timeline-item:last-child::before {
  display: none;
}

.timeline-content {
  background: #fff;
  border-radius: 15rpx;
  padding: 30rpx;
}

.record-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.record-stage {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.record-time {
  font-size: 24rpx;
  color: #999;
}

.record-details {
  margin: 20rpx 0;
}

.detail-row {
  display: flex;
  padding: 10rpx 0;
  font-size: 26rpx;
}

.detail-label {
  color: #666;
  margin-right: 10rpx;
  flex-shrink: 0;
}

.detail-value {
  color: #333;
  flex: 1;
}

.record-description {
  padding: 20rpx;
  background: #f8f9fa;
  border-radius: 10rpx;
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  margin: 20rpx 0;
}

.record-images {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
  margin: 20rpx 0;
}

.record-image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 10rpx;
}

.record-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.record-by {
  font-size: 24rpx;
  color: #999;
}

.chain-status {
  font-size: 24rpx;
  color: #999;
  padding: 8rpx 16rpx;
  background: #f5f5f5;
  border-radius: 20rpx;
}

.chain-status.on-chain {
  color: #2e7d32;
  background: #e8f5e9;
}

/* 区块链卡片 */
.blockchain-card {
  background: #fff;
  border-radius: 15rpx;
  padding: 40rpx;
}

.blockchain-status {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  border-radius: 15rpx;
  margin-bottom: 30rpx;
}

.blockchain-status.verified {
  background: #e8f5e9;
}

.blockchain-status.unverified {
  background: #fff3e0;
}

.status-icon {
  font-size: 60rpx;
  margin-right: 20rpx;
}

.status-text {
  font-size: 32rpx;
  font-weight: bold;
}

.blockchain-info {
  margin-bottom: 30rpx;
}

.blockchain-item {
  padding: 25rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.blockchain-item:last-child {
  border-bottom: none;
}

.blockchain-label {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 15rpx;
}

.blockchain-value {
  display: block;
  font-size: 28rpx;
  color: #333;
}

.hash-container {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.blockchain-value.hash {
  flex: 1;
  word-break: break-all;
  font-family: monospace;
  font-size: 24rpx;
}

.copy-button {
  flex-shrink: 0;
  padding: 10rpx 20rpx;
  background: #667eea;
  color: #fff;
  border-radius: 8rpx;
  font-size: 24rpx;
}

.blockchain-tip {
  display: flex;
  padding: 30rpx;
  background: #f8f9fa;
  border-radius: 15rpx;
}

.tip-icon {
  font-size: 36rpx;
  margin-right: 15rpx;
  flex-shrink: 0;
}

.tip-text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  flex: 1;
}

/* 空提示 */
.empty-tip {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}

<view class="container">
  <!-- 收货地址 -->
  <view class="address-section" bindtap="selectAddress">
    <view class="address-content" wx:if="{{address}}">
      <view class="address-header">
        <text class="receiver">{{address.receiverName}}</text>
        <text class="phone">{{address.receiverPhone}}</text>
        <text class="default-tag" wx:if="{{address.isDefault}}">默认</text>
      </view>
      <view class="address-detail">
        {{address.province}}{{address.city}}{{address.district}}{{address.detailAddress}}
      </view>
    </view>
    <view class="no-address" wx:else>
      <text class="icon">📍</text>
      <text class="text">请选择收货地址</text>
    </view>
    <text class="arrow">›</text>
  </view>

  <!-- 商品列表 -->
  <view class="goods-section">
    <view class="section-title">商品清单</view>
    <view class="goods-list">
      <view class="goods-item" wx:for="{{items}}" wx:key="productId">
        <image class="goods-image" src="{{item.imageUrl || '/images/default-product.png'}}" mode="aspectFill"></image>
        <view class="goods-info">
          <text class="goods-name">{{item.productName}}</text>
          <view class="goods-footer">
            <text class="goods-price">¥{{item.price}}/{{item.unit}}</text>
            <text class="goods-quantity">x{{item.quantity}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 配送方式 -->
  <view class="delivery-section">
    <view class="delivery-item">
      <text class="label">配送方式</text>
      <text class="value">快递配送</text>
    </view>
  </view>

  <!-- 订单备注 -->
  <view class="remark-section">
    <view class="remark-label">订单备注</view>
    <textarea 
      class="remark-input" 
      placeholder="选填，请输入备注信息"
      value="{{remark}}"
      bindinput="onRemarkInput"
      maxlength="200"
    ></textarea>
  </view>

  <!-- 价格明细 -->
  <view class="price-section">
    <view class="price-item">
      <text class="label">商品总价</text>
      <text class="value">¥{{totalAmount.toFixed(2)}}</text>
    </view>
    <view class="price-item">
      <text class="label">配送费</text>
      <text class="value">¥0.00</text>
    </view>
  </view>

  <!-- 底部提交栏 -->
  <view class="footer">
    <view class="total-box">
      <text class="label">合计：</text>
      <text class="amount">¥{{totalAmount}}</text>
    </view>
    <view class="btn-submit {{submitting ? 'disabled' : ''}}" bindtap="handleSubmit">
      <text>{{submitting ? '提交中...' : '提交订单'}}</text>
    </view>
  </view>
</view>

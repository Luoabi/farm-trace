/* Skyline 渲染引擎样式修复 */
page {
  height: 100%;
  width: 100%;
}

.container {
  min-height: 100vh;
  width: 100%;
  background: #f5f5f5;
  padding-bottom: 120rpx;
  box-sizing: border-box;
}

.cart-list {
  padding: 20rpx;
  width: 100%;
  box-sizing: border-box;
}

.cart-item {
  display: flex;
  align-items: center;
  background: white;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  gap: 20rpx;
  width: 100%;
  box-sizing: border-box;
}

.checkbox {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.icon {
  font-size: 40rpx;
  line-height: 1;
}

.product-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background: #f5f5f5;
  flex-shrink: 0;
  display: block;
}

.product-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  min-width: 0;
}

.product-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  line-height: 1.4;
}

.price-box {
  display: flex;
  align-items: baseline;
}

.price {
  font-size: 32rpx;
  font-weight: bold;
  color: #ff6b6b;
  line-height: 1.2;
}

.unit {
  font-size: 24rpx;
  color: #999;
  margin-left: 4rpx;
  line-height: 1.5;
}

.quantity-box {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.btn-minus,
.btn-plus {
  width: 48rpx;
  height: 48rpx;
  background: #f5f7fa;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #666;
  line-height: 1;
  flex-shrink: 0;
}

.quantity {
  min-width: 60rpx;
  text-align: center;
  font-size: 28rpx;
  line-height: 1.5;
}

.btn-delete {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  line-height: 1;
  flex-shrink: 0;
}

.empty {
  text-align: center;
  padding: 200rpx 0;
  width: 100%;
}

.empty-icon {
  display: block;
  font-size: 120rpx;
  margin-bottom: 20rpx;
  line-height: 1;
}

.empty-text {
  display: block;
  font-size: 28rpx;
  color: #999;
  margin-bottom: 40rpx;
  line-height: 1.5;
}

.btn-go-shop {
  width: 300rpx;
  height: 80rpx;
  line-height: 80rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  font-size: 28rpx;
  border-radius: 40rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-go-shop::after {
  border: none;
}

.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  width: 100%;
  height: 120rpx;
  background: white;
  display: flex;
  align-items: center;
  padding: 0 20rpx;
  box-shadow: 0 -4rpx 12rpx rgba(0, 0, 0, 0.05);
  box-sizing: border-box;
}

.select-all {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-right: auto;
}

.text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
}

.total-box {
  display: flex;
  align-items: baseline;
  margin-right: 20rpx;
}

.label {
  font-size: 28rpx;
  color: #666;
  line-height: 1.5;
}

.total-box .price {
  font-size: 36rpx;
  font-weight: bold;
  color: #ff6b6b;
  line-height: 1.2;
}

.btn-checkout {
  width: 200rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
